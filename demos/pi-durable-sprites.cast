[9.369964, "o", "  \u001b[38;5;135m▸\u001b[0m \u001b[1mbash\u001b[0m  pwd; node -v; cat > server.js <<'EOF'\r\n    \u001b[2mconst http = require('http');\u001b[0m\r\n    \u001b[2mconst os = require('os');\u001b[0m\r\n    \u001b[2mhttp.createServer((req, res) => {\u001b[0m\r\n    \u001b[2m  res.setHeader('Content-Type', 'text/plain');\u001b[0m\r\n    \u001b[2m  res.end(`hostname: ${os.hostname()}\\nuptime: ${os.uptime()}s\\n`);\u001b[0m\r\n    \u001b[2m}).listen(8080, () => console.log('listening on 8080'));\u001b[0m\r\n    \u001b[2mEOF\u001b[0m\r\n"]
